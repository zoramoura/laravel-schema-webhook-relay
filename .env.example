# =============================================================================
# Multi-Tenant Webhook Relay & JSON-Schema Plugin Engine
# Local development defaults — NEVER commit real credentials.
# All secrets must be injected at runtime (CI secrets, Docker secrets, env).
# =============================================================================

APP_NAME="Webhook Relay"
APP_ENV=local
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_URL=http://localhost

# Application timezone & locale
APP_TIMEZONE=UTC
APP_LOCALE=en

# -----------------------------------------------------------------------------
# Database (MySQL default; set DB_CONNECTION=pgsql to use Postgres)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webhook_relay
DB_USERNAME=relay
DB_PASSWORD=relay_local_password

# -----------------------------------------------------------------------------
# Queue / Cache / Sessions (Redis)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
CACHES_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Horizon
# -----------------------------------------------------------------------------
HORIZON_PATH=/horizon

# -----------------------------------------------------------------------------
# Ingestion security
#   WEBHOOK_REPLAY_WINDOW_SECONDS : allowed clock skew for timestamp header
#   WEBHOOK_IDEMPOTENCY_TTL_SECONDS: how long an idempotency key is remembered
# -----------------------------------------------------------------------------
WEBHOOK_REPLAY_WINDOW_SECONDS=300
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Outbound delivery
#   WEBHOOK_OUTBOUND_BASE_DELAY_SECONDS : initial retry delay
#   WEBHOOK_OUTBOUND_MAX_ATTEMPTS       : retry budget before DLQ
#   WEBHOOK_OUTBOUND_TIMEOUT_SECONDS    : HTTP client timeout
# -----------------------------------------------------------------------------
WEBHOOK_OUTBOUND_BASE_DELAY_SECONDS=5
WEBHOOK_OUTBOUND_MAX_ATTEMPTS=5
WEBHOOK_OUTBOUND_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Structured logging (LOG_CHANNEL=stack writes JSON to stderr)
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Mail (not used by core flow; safe local defaults only)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Sanctum / session domain for Inertia SPA
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_DOMAIN=localhost

# =============================================================================
# Zero hardcoded secrets: APP_KEY, DB_PASSWORD, REDIS_PASSWORD, tenant secrets
# must be provided via environment at deploy time. .env.example documents only
# safe local defaults for one-command spin-up.
# =============================================================================